{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TempRebuildRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<DATA_BUCKET>/raw/*"
    },
    {
      "Sid": "TempRebuildList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<DATA_BUCKET>",
      "Condition": { "StringLike": { "s3:prefix": "raw/*" } }
    }
  ]
}